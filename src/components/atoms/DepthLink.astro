---
interface Props {
  href: string;
  label: string;
  /** Which way along the vertical axis the link moves. */
  direction: 'down' | 'up';
}

const { href, label, direction } = Astro.props;
---

{/*
  The affordance for the vertical axis. A link, not a button: it moves to an
  anchor, the browser does the scrolling, and it works without JavaScript
  (decisions/0005). The arrow is decorative — the label already says where it
  goes.
*/}
<a
  class="inline-flex items-center gap-[0.55rem] border-b border-accent-line pb-[0.15rem] font-mono text-[0.74rem] text-accent hover:border-accent"
  href={href}
  data-depth-link
>
  {label}
  <span aria-hidden="true">{direction === 'down' ? '↓' : '↑'}</span>
</a>
