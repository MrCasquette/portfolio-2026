---
import { statusLabels, type ProjectStatus } from '../../data/portfolio';

interface Props {
  status: ProjectStatus;
}

const { status } = Astro.props;

/**
 * The three states differ by shape as much as by colour: the accent only
 * signals what is running, and information never rests on hue alone
 * (DESIGN.md §5.3, §7).
 */
const styles: Record<ProjectStatus, string> = {
  production: 'text-accent bg-accent-bg border-solid',
  delivered: 'text-ink-3 border-solid',
  wip: 'text-ink-2 border-dashed',
};
---

<span
  class:list={[
    'self-start rounded-full border border-current px-2 py-[0.14rem] font-mono text-[0.66rem] whitespace-nowrap',
    styles[status],
  ]}
>
  {statusLabels[status]}
</span>
