---
import { type ProjectState, PROJECT_STATE_LABELS } from '../../content/definitions/vocabulary';

interface Props {
  state: ProjectState;
}

const { state } = Astro.props;

/**
 * The three states differ by shape as much as by colour: the accent only
 * signals what is running, and information never rests on hue alone
 * (docs/design/composants.md, docs/design/accessibilite.md).
 */
const styles: Record<ProjectState, string> = {
  'in-production': 'text-accent bg-accent-bg border-solid',
  shipped: 'text-ink-3 border-solid',
  'in-progress': 'text-ink-2 border-dashed',
};
---

<span
  class:list={[
    'self-start rounded-full border border-current px-2 py-0.5 font-mono text-xs whitespace-nowrap',
    styles[state],
  ]}
>
  {PROJECT_STATE_LABELS[state]}
</span>
