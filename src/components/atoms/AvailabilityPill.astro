---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<p
  class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-[0.68rem] py-[0.28rem] font-mono text-meta text-ink-2"
>
  <span
    class="size-[0.4rem] rounded-full bg-accent shadow-[0_0_0_3px_var(--color-accent-halo)]"
    aria-hidden="true"></span>
  {label}
</p>
