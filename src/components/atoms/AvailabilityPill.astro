---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<p
  class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-2.5 py-1 font-mono text-meta text-ink-2"
>
  <span
    class="size-1.5 rounded-full bg-accent shadow-halo"
    aria-hidden="true"></span>
  {label}
</p>
