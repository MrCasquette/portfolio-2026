---
import { mainNavigation } from '../../data/portfolio';
---

<nav class="fixed-navigation" aria-label="Navigation principale" data-navigation>
  {
    mainNavigation.map(item => (
      <a href={item.href}>
        <span class="nav-marker" />
        <span class="long-label">{item.label}</span>
        <span class="short-label">{item.shortLabel}</span>
      </a>
    ))
  }
</nav>
