---
import { chapters } from '../../data/journey';
---

{/*
  Real links: the position in the journey stays in the URL, shareable and
  restored on back-navigation. The keyboard works with no code, and the
  left/right arrows are layered on top (DESIGN.md §7).
*/}
<nav
  class="fixed inset-x-0 bottom-0 z-30 flex h-rail items-center overflow-x-auto bg-bg [scrollbar-width:none]"
  aria-label="Parcours"
  data-rail
>
  <ol
    class="relative flex w-full min-w-160 list-none px-gutter pb-1"
    style={`--step-count:${chapters.length}`}
    data-rail-track
  >
    {
      chapters.map((chapter, index) => (
        <li
          class="group relative flex flex-1"
          style={`--fill:clamp(0,calc(var(--active-index,0) - ${index}),1); --lit:clamp(0,calc(var(--active-index,0) - ${index - 1}),1)`}
          data-rail-step={chapter.id}
          data-rail-target={chapter.step}
        >
          {/*
            The connector fills rather than switching. `--fill` is the share of
            the way to the next chapter already covered, so the line grows at
            exactly the speed the underline travels — one movement read twice,
            instead of a bar that glides past a rail that snaps.

            Declared inline rather than as a Tailwind arbitrary property: the
            generator drops `[--fill:clamp(…)]`, and an undefined variable makes
            the whole `transform` invalid, which shows every connector full.

            `--fill` is declared inline rather than as a Tailwind arbitrary
            property: the generator drops `[--fill:clamp(…)]`, and an undefined
            variable invalidates the whole `transform`, which shows every
            connector full.

            Rendered only between two chapters: no connector hangs off the last
            bullet, and no `:last-of-type` rule is needed to hide one.
          */}
          {index < chapters.length - 1 && (
            <span
              class="pointer-events-none absolute top-3.25 right-[calc(-50%+0.5rem)] left-[calc(50%+0.5rem)] h-px bg-line"
              aria-hidden="true"
            >
              <span class="block h-px origin-left bg-accent-line scale-x-(--fill)" />
            </span>
          )}

          <a
            class="flex flex-1 flex-col items-center gap-2.5 py-1.5"
            href={`#${chapter.id}`}
          >
            {/*
              Two layers, so the bullet lights up instead of switching colour:
              the ring holds the place at all times, and the fill grows from the
              centre while it fades in.

              Driven by the scroll, not by a transition. `--lit` is the share of
              the way *into* this chapter already covered — the fill of the
              connector that leads to it — so the bullet lights up across the
              whole lateral leg, at the speed of that connector and of the
              underline. A transition started it on arrival instead, once the
              movement was over, and that lateness is what read as abrupt: no
              curve and no duration could fix a cue that fires after the fact.

              The first bullet resolves to 1 from the outset: nothing leads to it.
            */}
            <span
              class="grid size-3.5 place-items-center rounded-full border border-line bg-bg transition duration-500 group-data-[state=past]:border-accent-line group-data-[state=current]:border-accent group-data-[state=current]:shadow-halo"
              aria-hidden="true"
            >
              <span
                class="size-full scale-(--lit) rounded-full bg-accent-line opacity-(--lit) transition-colors duration-500 group-data-[state=current]:bg-accent"
              />
            </span>
            <span class="text-rail whitespace-nowrap text-ink-3 transition-colors duration-500 group-hover:text-ink-2 group-data-[state=current]:font-medium group-data-[state=current]:text-ink">
              {chapter.label}
            </span>
          </a>
        </li>
      ))
    }

    {/*
      Current-chapter underline. The outer box is one step wide and carries the
      movement; the visible bar is centred inside it.

      An absolutely positioned element resolves entirely against its container's
      padding box — offsets *and* percentage widths. The gutter must therefore be
      compensated twice: `left` catches it up, and the step width subtracts it.
      Without the second correction the error accumulates from one step to the
      next.
    */}
    <span
      class="pointer-events-none absolute bottom-0 left-gutter flex w-[calc((100%-2*var(--spacing-gutter))/var(--step-count))] justify-center translate-x-(--rail-shift)"
      style="--rail-shift:calc(var(--active-index,0) * 100%)"
      aria-hidden="true"
    >
      <span class="h-0.5 w-3/5 rounded-full bg-accent"></span>
    </span>
  </ol>
</nav>
