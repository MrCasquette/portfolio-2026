---
import DecisionEntry from '../molecules/DecisionEntry.astro';
import type { Decision } from '../../data/portfolio';

interface Props {
  decisions: Decision[];
}

const { decisions } = Astro.props;
---

<div class="mt-6 border-t border-line">
  <div
    class="grid grid-cols-1 border-b border-line-soft py-2 font-mono text-xs tracking-widest text-ink-3 uppercase md:grid-cols-2 md:gap-x-5"
  >
    <span>Retenu</span>
    <span>Écarté</span>
  </div>
  {decisions.map(decision => <DecisionEntry decision={decision} />)}
</div>
