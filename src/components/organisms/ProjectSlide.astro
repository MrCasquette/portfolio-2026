---
import Chip from '../atoms/Chip.astro';
import DepthLink from '../atoms/DepthLink.astro';
import Kicker from '../atoms/Kicker.astro';
import StatePill from '../atoms/StatePill.astro';
import CodeExcerpt from './CodeExcerpt.astro';
import DecisionLedger from './DecisionLedger.astro';
import IncidentTimeline from './IncidentTimeline.astro';
import Slide from '../templates/Slide.astro';
import type { Project } from '../../data/portfolio';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

/**
 * Depth panels, derived from what the project actually carries.
 *
 * The grain is the arbitrage: each decision gets its own screen, which is what
 * `scroll-snap-stop: always` exists to guarantee. A ledger read three entries at
 * a time is a table; read one screen at a time it is an argument.
 *
 * The invariant behind the whole thing: **a panel fits one screen**. If a block
 * outgrows it, it is split into two panels — never traded for fluid scrolling,
 * which would put two unrelated artefacts in the same view.
 */
type Panel =
  | { kind: 'decision'; index: number }
  | { kind: 'incident' }
  | { kind: 'excerpt' };

const panels: Panel[] = [
  ...project.decisions.map((_decision, decisionIndex) => ({
    kind: 'decision' as const,
    index: decisionIndex,
  })),
  ...(project.incident ? [{ kind: 'incident' as const }] : []),
  ...(project.excerpt ? [{ kind: 'excerpt' as const }] : []),
];

const panelId = (panel: Panel) =>
  panel.kind === 'decision'
    ? `${project.id}-decision-${panel.index + 1}`
    : `${project.id}-${panel.kind}`;

const panelTitle = (panel: Panel) => {
  if (panel.kind === 'incident') return 'Incident';
  if (panel.kind === 'excerpt') return 'Extrait';

  const position = String(panel.index + 1).padStart(2, '0');
  return `Arbitrage ${position} / ${String(project.decisions.length).padStart(2, '0')}`;
};
---

{/* The path dies here: the first project is the threshold of the vertical axis. */}
<Slide id={project.id} path={index === 1} pathFade="out" deep={panels.length > 0}>
  <div class="slide-panel" id={`${project.id}-intro`}>
    <Kicker text={`Projet ${String(index).padStart(2, '0')} — ${project.verb}`} />
    <div class="flex flex-wrap items-center gap-3">
      <h2 class="text-h2">{project.title}</h2>
      <StatePill status={project.status} />
    </div>
    <p class="mt-[0.9rem] max-w-[58ch] text-[0.99rem] text-ink-2">{project.intro}</p>

    {/*
      What was used on this project, not a catalogue of mastery: here the list
      becomes judgeable, since it reads against the trade-offs that follow.
    */}
    <ul
      class="mt-[1.1rem] flex list-none flex-wrap gap-[0.4rem]"
      aria-label={`Technologies employées sur ${project.title}`}
    >
      {project.stack.map(item => (
        <li>
          <Chip label={item} />
        </li>
      ))}
    </ul>

    {
      panels.length > 0 && (
        <Fragment>
          <p class="mt-[1.9rem]">
            <DepthLink href={`#${panelId(panels[0])}`} label="Explorer" direction="down" />
          </p>
          {/* The path turns down: the axis continues, and the frame cuts it. */}
          <div class="descent-path" aria-hidden="true" />
        </Fragment>
      )
    }
  </div>

  {
    panels.map((panel, panelIndex) => (
      <div class="slide-panel" id={panelId(panel)}>
        <Kicker text={`${project.title} — ${panelTitle(panel)}`} />
        {panel.kind === 'decision' && (
          <DecisionLedger decisions={[project.decisions[panel.index]]} />
        )}
        {panel.kind === 'incident' && project.incident && (
          <IncidentTimeline events={project.incident} />
        )}
        {panel.kind === 'excerpt' && project.excerpt && <CodeExcerpt excerpt={project.excerpt} />}
        {panelIndex === panels.length - 1 && (
          <p class="mt-[1.9rem]">
            <DepthLink href={`#${project.id}-intro`} label="Revenir au projet" direction="up" />
          </p>
        )}
      </div>
    ))
  }
</Slide>
