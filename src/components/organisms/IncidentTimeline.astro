---
import type { IncidentEvent } from '../../data/portfolio';

interface Props {
  events: IncidentEvent[];
}

const { events } = Astro.props;
---

{/*
  Only the first bullet is accented: the accent marks the trigger, not the
  resolution — jade at the end of a timeline would read as a validation tick
  (DESIGN.md §3, §5.4).
*/}
<ol
  class="relative mt-6 list-none pl-5.5 before:absolute before:top-3 before:bottom-3 before:left-0.75 before:w-px before:bg-line before:content-['']"
>
  {
    events.map((event, index) => (
      <li class="relative grid grid-cols-1 py-2 md:grid-cols-[4.6rem_1fr] md:gap-4">
        <span
          class:list={[
            'absolute top-2.5 -left-5.5 size-1.5 rounded-full border border-bg',
            index === 0 ? 'bg-accent' : 'bg-line',
          ]}
          aria-hidden="true"
        />
        <time class:list={['font-mono text-meta', index === 0 ? 'text-accent' : 'text-ink-3']}>
          {event.at}
        </time>
        <span
          class:list={[
            'text-body',
            index === events.length - 1 ? 'text-ink' : 'text-ink-2',
          ]}
        >
          {event.label}
        </span>
      </li>
    ))
  }
</ol>
