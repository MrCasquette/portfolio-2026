---
/**
 * A step only an operated system can carry.
 *
 * Only the first bullet is accented: the accent marks the trigger, not the
 * resolution — jade at the end of a timeline would read as a validation tick
 * (docs/design/vocabulaire.md, docs/design/composants.md).
 */
import type { Incident } from '../../content/load';
import Prose from '../../content/render/Prose.astro';

interface Props {
  incident: Incident;
}

const { incident } = Astro.props;
const { timeline } = incident;
---

<h3 class="text-h3">{incident.title}</h3>
<div class="mt-3 max-w-prose text-body text-ink-2"><Prose source={incident.stakes} /></div>

<ol
  class="relative mt-6 list-none pl-5.5 before:absolute before:top-3 before:bottom-3 before:left-0.75 before:w-px before:bg-line before:content-['']"
>
  {
    timeline.map((event, index) => (
      <li class="relative grid grid-cols-1 py-2 md:grid-cols-[4.6rem_1fr] md:gap-4">
        <span
          class:list={[
            'absolute top-2.5 -left-5.5 size-1.5 rounded-full border border-bg',
            index === 0 ? 'bg-accent' : 'bg-line',
          ]}
          aria-hidden="true"
        />
        <time class:list={['font-mono text-meta', index === 0 ? 'text-accent' : 'text-ink-3']}>
          {event.at}
        </time>
        <span class:list={['text-body', index === timeline.length - 1 ? 'text-ink' : 'text-ink-2']}>
          {event.label}
        </span>
      </li>
    ))
  }
</ol>

<div class="mt-4 max-w-prose text-body text-ink"><Prose source={incident.resolution} /></div>
{
  incident.lesson && (
    <div class="mt-3 border-l-2 border-accent-line py-0.5 pl-3 text-sm leading-relaxed text-ink-2">
      <Prose source={incident.lesson} />
    </div>
  )
}
