---
/**
 * The first step. The only place allowed to speak before proving.
 *
 * It names Vincent, because the header only appears from the second chapter and
 * nothing else would (docs/decisions/0007-en-tete-differe.md). The role is the
 * rich text: it carries the one accented word of the whole site, as a
 * `:highlight[…]` directive rather than a split in the renderer.
 */
import type { Section } from '../../content/load';
import Prose from '../../content/render/Prose.astro';
import AvailabilityPill from '../atoms/AvailabilityPill.astro';
import ActionLink from '../atoms/ActionLink.astro';

interface Props {
  data: Extract<Section, { type: 'statement' }>['data'];
}

const { data } = Astro.props;
---

<div
  class="grid items-start gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-x-24"
>
  <div>
    <h1 class="text-h1">{data.name}</h1>
    <p class="mt-2 text-h2 text-ink-2"><Prose source={data.role} inline /></p>
    {
      data.availability && (
        <div class="mt-8">
          <AvailabilityPill label={data.availability} />
        </div>
      )
    }
  </div>
  <div class="flex flex-col gap-8">
    <div class="text-lede text-ink-2"><Prose source={data.description} /></div>
    <div class="flex flex-wrap gap-3">
      {
        data.actions.map((action, position) => (
          <ActionLink label={action.label} href={action.href} primary={position === 0} />
        ))
      }
    </div>
  </div>
</div>
