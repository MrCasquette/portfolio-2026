---
import { identity } from '../../data/portfolio';
---

<header
  class="fixed inset-x-0 top-0 z-30 flex h-header items-center justify-between gap-4 border-b border-line-soft bg-bg/90 px-gutter backdrop-blur-[10px]"
>
  <p class="text-base font-semibold tracking-[-0.03em] whitespace-nowrap">
    {identity.name}<span class="text-accent">.</span>
  </p>
  <p class="font-mono text-[0.78rem] whitespace-nowrap text-ink-2 max-[620px]:hidden">
    {identity.tagline}
  </p>
</header>
