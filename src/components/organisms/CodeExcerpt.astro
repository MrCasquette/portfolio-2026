---
/**
 * The last step of a descent: what prose could not prove.
 *
 * The theme is the site's own (`docs/design/vocabulaire.md` forbids importing an editor theme), and
 * the language is an enum rather than a free string — which is what removes the
 * `lang={… as never}` this component used to carry.
 */
import { Code } from 'astro:components';
import type { Excerpt } from '../../content/load';
import Prose from '../../content/render/Prose.astro';
import { codeTheme } from '../../styles/code-theme';

interface Props {
  excerpt: Excerpt;
}

const { excerpt } = Astro.props;
---

<div class="max-w-prose text-body text-ink-2"><Prose source={excerpt.shows} /></div>

<figure class="mt-6 overflow-hidden rounded-card border border-line bg-code">
  <figcaption
    class="flex justify-between border-b border-line px-3.5 py-2 font-mono text-xs text-ink-3"
  >
    <span>{excerpt.path}</span>
    <span>extrait</span>
  </figcaption>
  <Code
    class="!bg-code overflow-x-auto p-3.5 text-code"
    code={excerpt.code}
    lang={excerpt.language}
    theme={codeTheme}
  />
</figure>

{
  excerpt.source && (
    <p class="mt-3 font-mono text-meta">
      <a class="text-accent" href={excerpt.source.href}>
        {excerpt.source.label} →
      </a>
    </p>
  )
}
