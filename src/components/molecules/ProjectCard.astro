---
import type { Project } from '../../content/load';
import Prose from '../../content/render/Prose.astro';
import StatePill from '../atoms/StatePill.astro';

interface Props {
  project: Project;
  /** What this project proves that the other two do not — the index says it, not the project. */
  proves: string;
  index: number;
}

const { project, proves, index } = Astro.props;
---

<article class="flex flex-col gap-3 rounded-card border border-line-soft bg-surface p-5">
  <StatePill state={project.state} />
  <h3 class="text-h3">{project.name}</h3>
  <p class="flex-1 text-body text-ink-2"><Prose source={proves} inline /></p>
  <a
    class="font-mono text-meta text-accent"
    href={`#${project.slug}`}
    aria-label={`Voir le détail du projet ${index} — ${project.name}`}
  >
    Voir le détail →
  </a>
</article>
