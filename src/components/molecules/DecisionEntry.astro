---
import type { Decision } from '../../data/portfolio';

interface Props {
  decision: Decision;
}

const { decision } = Astro.props;
---

<div
  class="grid grid-cols-1 border-b border-line-soft py-3 last:border-b-0 md:grid-cols-2 md:gap-x-5"
>
  {
    decision.state === 'settled' ? (
      <>
        <p class="flex gap-2 text-body font-normal text-ink">
          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
          {decision.kept}
        </p>
        <p class="pl-3.5 text-body text-ink-3 line-through decoration-1 md:pl-0">
          {decision.discarded}
        </p>
      </>
    ) : (
      <>
        {/*
          Nothing is kept: no accent bullet, no strikethrough. Both options
          hold the same weight, and the state is named rather than inferred
          from a colour (DESIGN.md §5.1, §7).
        */}
        <p class="col-span-full mb-1.5 font-mono text-xs tracking-widest text-ink-3 uppercase">
          Non tranché
        </p>
        {decision.options.map(option => (
          <p class="flex gap-2 text-body font-normal text-ink-2">
            <span class="mt-3 h-px w-1.5 shrink-0 bg-ink-3" aria-hidden="true" />
            {option}
          </p>
        ))}
      </>
    )
  }
  <p
    class:list={[
      'col-span-full mt-2 border-l-2 py-0.5 pl-3 text-sm leading-relaxed text-ink-2',
      decision.state === 'settled' ? 'border-accent-line' : 'border-line',
    ]}
  >
    {decision.rationale}
  </p>
</div>
