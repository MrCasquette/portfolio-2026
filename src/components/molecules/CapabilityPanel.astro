---
interface Props {
  title: string;
  items: readonly { readonly lead: string; readonly text: string }[];
}

const { title, items } = Astro.props;
---

<section class="rounded-card border border-line-soft bg-surface p-5.5">
  <h3 class="mb-4 font-mono text-meta font-medium tracking-widest text-ink-3 uppercase">
    {title}
  </h3>
  <ul class="flex list-none flex-col gap-3">
    {
      items.map(item => (
        <li class="flex gap-2 text-body text-ink-2">
          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent-line" aria-hidden="true" />
          <span>
            <b class="font-medium text-ink">{item.lead}</b> {item.text}
          </span>
        </li>
      ))
    }
  </ul>
</section>
