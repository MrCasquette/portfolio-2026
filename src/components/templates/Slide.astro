---
interface Props {
  id: string;
  /** Maximum content width, when the chapter needs more than the reading column. */
  max?: string;
  /** Path segment for this chapter. Absent from chapters that carry depth. */
  path?: boolean;
  /** Where the segment starts, when the path is not born at the left edge. */
  pathStart?: string;
  /** Path birth or death, at either end of the journey. */
  pathFade?: 'in' | 'out';
  /** Composition resting on the path rather than centred in the chapter. */
  abovePath?: boolean;
  /** Content in the `edge` slot escapes the reading column: it places itself
      freely in the chapter, as a screen-edge marker. */
}

const { id, max, path = false, pathStart, pathFade, abovePath = false } = Astro.props;
---

<section class:list={['slide relative', abovePath && 'slide-above-path']} id={id}>
  {
    path && (
      <div
        class="slide-path"
        style={pathStart ? `--path-start:${pathStart}` : undefined}
        data-fade={pathFade}
        aria-hidden="true"
      />
    )
  }
  <div class="slide-content" style={max ? `--slide-max:${max}` : undefined}>
    <slot />
  </div>
  <slot name="edge" />
</section>
