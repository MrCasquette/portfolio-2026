---
/**
 * The page: walk the steps, hand each one to the component its kind names.
 *
 * The dispatch stays here, and stays type-checked, rather than moving into a
 * record of components: Astro does not check the props of a component looked up
 * at run time, and trading the types for one less line would give up exactly what
 * the declaration was built to provide. What *is* a registry lives in
 * `COMPOSITION` below — the constraints the path imposes on a chapter, in one
 * place instead of scattered through a cascade.
 *
 * Adding a section is a line here and a component beside it.
 */
import DepthIndicator from '../components/atoms/DepthIndicator.astro';
import Kicker from '../components/atoms/Kicker.astro';
import Arbitration from '../components/organisms/Arbitration.astro';
import CodeExcerpt from '../components/organisms/CodeExcerpt.astro';
import Contact from '../components/organisms/Contact.astro';
import IncidentTimeline from '../components/organisms/IncidentTimeline.astro';
import NavigationRail from '../components/organisms/NavigationRail.astro';
import ProjectLanding from '../components/organisms/ProjectLanding.astro';
import ProofIndex from '../components/organisms/ProofIndex.astro';
import SiteHeader from '../components/organisms/SiteHeader.astro';
import Statement from '../components/organisms/Statement.astro';
import Thesis from '../components/organisms/Thesis.astro';
import Step from '../components/templates/Step.astro';
import { chaptersOf, journeyOf, type StepContent } from '../content/journey';
import { loadPage } from '../content/load';
import { yamlSource } from '../content/provider/yaml/index';
import Layout from '../layouts/Layout.astro';

/**
 * How each kind of step sits against the path.
 *
 * These are not preferences. `docs/decisions/0010` requires a chapter crossing the
 * horizontal axis to expose a head and a *single* box row; `0006` requires it to
 * carry a boxed element at the path's height, or the line crosses a bare page.
 * The constraint used to be spread through the cascade this file replaced.
 */
const COMPOSITION: Record<StepContent['kind'], { compose?: 'above' | 'on'; max?: string }> = {
  statement: { compose: 'above', max: '78rem' },
  thesis: { compose: 'on' },
  index: { compose: 'on' },
  project: {},
  arbitration: {},
  incident: {},
  excerpt: {},
  contact: { compose: 'above' },
};

const page = await loadPage(yamlSource('content'), 'home');
const steps = journeyOf(page);
const chapters = chaptersOf(steps);
---

<Layout title={page.title}>
  <SiteHeader identity={page.identity} />

  {/*
    The scroll driver: one screen of height per step, and nothing else in it.
    Every step is therefore a real scroll offset, which is what keeps anchors,
    the keyboard and find-in-page working without a line of code.
  */}
  <div class="driver" style={`--step-count:${steps.length}`} aria-hidden="true">
    {steps.map(() => <div class="driver-stop"></div>)}
  </div>

  <main class="view">
    <div class="journey-grid" data-grid>
      {
        steps.map(step => {
          const { content } = step;

          return (
            <Step {...step} {...COMPOSITION[content.kind]}>
              {content.kind === 'statement' && <Statement data={content.data} />}
              {content.kind === 'thesis' && <Thesis data={content.data} />}
              {content.kind === 'index' && (
                <ProofIndex data={content.data} projects={content.projects} />
              )}
              {content.kind === 'project' && (
                <ProjectLanding project={content.project} number={content.number} />
              )}
              {content.kind === 'arbitration' && (
                <>
                  <Kicker
                    text={`${content.project.name} — Arbitrage ${String(content.position).padStart(2, '0')} / ${String(content.total).padStart(2, '0')}`}
                  />
                  <Arbitration arbitration={content.arbitration} />
                </>
              )}
              {content.kind === 'incident' && (
                <>
                  <Kicker text={`${content.project.name} — Incident`} />
                  <IncidentTimeline incident={content.incident} />
                </>
              )}
              {content.kind === 'excerpt' && (
                <>
                  <Kicker text={`${content.project.name} — Extrait`} />
                  <CodeExcerpt excerpt={content.excerpt} />
                </>
              )}
              {content.kind === 'contact' && <Contact data={content.data} />}
            </Step>
          );
        })
      }
    </div>
  </main>

  <DepthIndicator />
  <NavigationRail chapters={chapters} />

  <script>
    import '../scripts/journey';
  </script>
</Layout>
