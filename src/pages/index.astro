---
import AvailabilityPill from '../components/atoms/AvailabilityPill.astro';
import Chip from '../components/atoms/Chip.astro';
import Kicker from '../components/atoms/Kicker.astro';
import CapabilityPanel from '../components/molecules/CapabilityPanel.astro';
import ProjectCard from '../components/molecules/ProjectCard.astro';
import NavigationRail from '../components/organisms/NavigationRail.astro';
import ProjectSlide from '../components/organisms/ProjectSlide.astro';
import SiteHeader from '../components/organisms/SiteHeader.astro';
import Slide from '../components/templates/Slide.astro';
import { contact, identity, landing, profile, projects, work } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';
---

<Layout title={`${identity.name} — ${identity.tagline}`}>
  <SiteHeader />

  <main class="deck">
    <Slide id="landing">
      <AvailabilityPill label={landing.availability} />
      <h1 class="text-h1">
        {
          landing.title.map(line => (
            <Fragment>
              {line.split(landing.emphasis).flatMap((part, index) =>
                index === 0 ? [part] : [<span class="text-accent">{landing.emphasis}</span>, part]
              )}
              <br />
            </Fragment>
          ))
        }
      </h1>
      <p class="mt-[1.35rem] max-w-[48ch] text-lede text-ink-2">{landing.lede}</p>
      <ul class="mt-[1.9rem] flex list-none flex-wrap gap-[0.4rem]" aria-label="Technologies">
        {landing.stack.map(item => <li><Chip label={item} /></li>)}
      </ul>
    </Slide>

    <Slide id="profile">
      <Kicker text="01 — Profil" />
      <h2 class="text-h2">{profile.title}</h2>
      <p class="mt-[0.9rem] max-w-[58ch] text-[0.99rem] text-ink-2">{profile.lede}</p>
      <div class="mt-8 grid grid-cols-2 gap-[1.6rem] max-[760px]:grid-cols-1 max-[760px]:gap-4">
        {profile.panels.map(panel => <CapabilityPanel title={panel.title} items={panel.items} />)}
      </div>
    </Slide>

    <Slide id="work">
      <Kicker text="02 — Réalisations" />
      <h2 class="text-h2">{work.title}</h2>
      <p class="mt-[0.9rem] max-w-[58ch] text-[0.99rem] text-ink-2">{work.lede}</p>
      <div class="mt-8 grid grid-cols-3 gap-4 max-[820px]:grid-cols-1">
        {projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}
      </div>
    </Slide>

    {projects.map((project, index) => <ProjectSlide project={project} index={index + 1} />)}

    <Slide id="contact">
      <Kicker text="03 — Contact" />
      <h2 class="text-h2">{contact.title}</h2>
      <p class="mt-[0.9rem] max-w-[58ch] text-[0.99rem] text-ink-2">{contact.lede}</p>
      <ul class="mt-[1.9rem] flex list-none flex-wrap gap-[1.4rem] font-mono text-[0.85rem]">
        {
          contact.links.map(link => (
            <li>
              <a class="border-b border-accent-line text-accent hover:border-accent" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </Slide>
  </main>

  <NavigationRail />

  <script>
    import '../scripts/parcours';
  </script>
</Layout>
