---
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Vincent Cottalorda — trois systèmes, et les décisions qui les tiennent.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
